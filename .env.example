# Server Network Configuration
HOST=0.0.0.0
PORT=8080

# Database Configuration (PostgreSQL)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/production_db

# Connection Pool Sizing (Tuned via Little's Law)
DATABASE_MAX_CONNECTIONS=50
DATABASE_MIN_CONNECTIONS=10
DATABASE_ACQUIRE_TIMEOUT_SECS=3

# Observability and Security
RUST_LOG=info,axum_production_template=debug,tower_http=info
REQUEST_TIMEOUT_SECS=10
CORS_ALLOWED_ORIGIN=*
